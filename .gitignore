# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.obj
*.o
*.pyd

# Virtual Environments
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Jupyter Notebook Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Data files (Strictly avoid committing large or raw retail datasets to GitHub)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Serialized Model Artifacts (avoid pushing heavy binary weights)
models/*
!models/.gitkeep

# Testing and Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Generated Reports & Figures (tracked for GitHub portfolio proof; uncomment if needed)
# reports/*.csv
# reports/figures/*

# IDE and OS specific files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
